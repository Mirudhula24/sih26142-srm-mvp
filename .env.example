# ---- API Gateway ----
API_HOST=0.0.0.0
API_PORT=8000
CORS_ORIGINS=http://localhost:3000

# ---- PostGIS ----
POSTGRES_USER=srm
POSTGRES_PASSWORD=srm_dev_password
POSTGRES_DB=srm
POSTGRES_HOST=postgis
POSTGRES_PORT=5432

# ---- Redis / Celery ----
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# ---- Storage ----
COG_STORAGE_DIR=/data/cogs
DATA_CACHE_DIR=/data/cache

# ---- STAC ingestion ----
STAC_ENDPOINT=https://planetarycomputer.microsoft.com/api/stac/v1
STAC_COLLECTION=sentinel-2-l2a
STAC_TIMEOUT_SECONDS=3
MAX_CLOUD_COVER=10.0
OFFLINE_MODE=false

# ---- Inference ----
SCALE_FACTOR=4
MODEL_WEIGHTS_PATH=/app/weights/sih26142_srm_v1.pth
DEVICE=cuda
MAX_PATCH_SIZE=256

# ---- Thread-pool isolation (see docs/TECH_CLASHES.md, Clash 1) ----
OMP_NUM_THREADS=1
OPENBLAS_NUM_THREADS=1
MKL_NUM_THREADS=1
NUMEXPR_NUM_THREADS=1

# ---- Frontend ----
VITE_API_BASE_URL=http://localhost:8000
VITE_TITILER_BASE_URL=http://localhost:8001
